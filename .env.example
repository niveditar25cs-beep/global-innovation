# =============================================================================
# .env.example — Environment variable reference for Docker Compose
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual credentials before running docker compose
#
# IMPORTANT: Never commit your actual .env file to version control.
#            Only .env.example belongs in the repository.
# =============================================================================

# ─────────────────────────── Application ─────────────────────────────────────
APP_NAME=Transformer Failure Risk Monitoring System
APP_ENV=development

# ─────────────────────────── Server ──────────────────────────────────────────
# Port exposed by the backend container to your local machine
BACKEND_PORT=8000

# ─────────────────────────── PostgreSQL ──────────────────────────────────────
# Credentials used both by the postgres container and the backend DATABASE_URL
# Change POSTGRES_PASSWORD before deploying to any non-local environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transformer_db

# Port exposed by the postgres container to your local machine
# (The backend always connects via the internal Docker network hostname 'postgres')
POSTGRES_PORT=5432

# ─────────────────────────── Redis ───────────────────────────────────────────
# Port exposed by the redis container to your local machine
REDIS_PORT=6379

# Redis memory management
REDIS_MAXMEMORY=128mb

# Redis client settings for the backend
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=1.5
REDIS_SOCKET_CONNECT_TIMEOUT=1.5

# Cursor state TTL (seconds) — 4 hours default
REDIS_CURSOR_TTL_SECONDS=14400

# Cache TTL (seconds) — 1 minute default
REDIS_CACHE_TTL_SECONDS=60

# Rate limiting
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_REQUESTS=100
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# ─────────────────────────── CORS ────────────────────────────────────────────
# For local development, allow all origins.
# In production, replace with a comma-separated list of trusted frontend origins:
#   CORS_ORIGINS=https://your-frontend.example.com,https://another-origin.example.com
CORS_ORIGINS=*

# ─────────────────────────── Security ────────────────────────────────────────
# Set to true in production (requires HTTPS)
ENABLE_SECURITY_HEADERS=true
STRICT_TRANSPORT_SECURITY=false
