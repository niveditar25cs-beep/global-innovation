# =============================================================================
# backend/.env.example — Backend-specific environment variables
#
# When running LOCALLY (without Docker), copy this file to backend/.env
# and adjust values to match your local PostgreSQL and Redis installation.
#
# When running with DOCKER COMPOSE, environment variables are injected
# directly by docker-compose.yml using the root .env.example as the template.
#   → See: global-innovation/.env.example
# =============================================================================

# ─── Application
APP_NAME=Transformer Failure Risk Monitoring System
APP_ENV=development

# ─── Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# ─── CORS (use * for local dev; restrict to specific origins in production)
CORS_ORIGINS=*

# ─── PostgreSQL (local development; Docker uses 'postgres' hostname)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transformer_db

# ─── Dataset
SAMPLE_DATASET_PATH=./data/sample_transformer_data.csv

# ─── Redis (local development; Docker uses 'redis' hostname)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=1.5
REDIS_SOCKET_CONNECT_TIMEOUT=1.5
REDIS_CURSOR_TTL_SECONDS=14400
REDIS_CACHE_TTL_SECONDS=60
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_REQUESTS=100
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# ─── Security
ENABLE_SECURITY_HEADERS=true
STRICT_TRANSPORT_SECURITY=false
